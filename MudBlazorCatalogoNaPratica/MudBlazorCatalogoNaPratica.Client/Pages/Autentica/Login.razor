@page "/login"

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-4 w-100" Style="border-radius: 12px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2"><strong>Entrar</strong></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="opacity-70">Faça login para acessar o sistema</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        
        <MudCardContent>
            @if (LoginFahou)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@AvisoMensagem</MudAlert>
                <div class="d-none">
                    <Aviso Exibir="@LoginFahou">@AvisoMensagem</Aviso>
                </div>
            }

            <EditForm Model="@userInfo" OnValidSubmit="FazerLogin">
                <DataAnnotationsValidator />
                
                <MudTextField @bind-Value="userInfo.Email" 
                              For="@(() => userInfo.Email)"
                              Label="E-mail" 
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End" 
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4" />

                <MudTextField @bind-Value="userInfo.Password" 
                              For="@(() => userInfo.Password)"
                              Label="Senha" 
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@PasswordInput"
                              Adornment="Adornment.End" 
                              AdornmentIcon="@PasswordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Mostrar Senha"
                              Class="mb-6" />

                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large" 
                           FullWidth="true"
                           Class="py-2"
                           Style="border-radius: 8px;">
                    <strong>ACESSAR</strong>
                </MudButton>
            </EditForm>
        </MudCardContent>
        
        <MudCardActions Class="d-flex justify-center mt-2 pb-4">
            <MudText Typo="Typo.body2">Não tem uma conta?</MudText>
            <MudButton Href="/register" Variant="Variant.Text" Color="Color.Primary" Class="ml-2">Registre-se</MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>
@code {
    private UserInfo userInfo = new UserInfo();
    bool LoginFahou = false;
    
    [Parameter]
    public string AvisoMensagem { get; set; }

    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    async Task FazerLogin()
    {
        try
        {
            var loginAsJson = JsonSerializer.Serialize(userInfo);

            var httpResonse = await Http.PostAsync("api/Autentica/Login",
                new StringContent(loginAsJson, Encoding.UTF8, "application/json"));


            if (httpResonse.IsSuccessStatusCode)
            {
                var responseAsString = await httpResonse.Content.ReadAsStringAsync();

                var loginResult = JsonSerializer.Deserialize<UserToken>(
                    responseAsString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                await authStateProvider.Login(loginResult.Token);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                LoginFahou = true;
                AvisoMensagem = "Falha ao efetuar login, verifique seu usuário e senha.";
            }
        }
        catch(Exception)
        {
            LoginFahou = true;
            AvisoMensagem = "Falha ao efetuar login, verifique seu usuário e senha.";
        }
    }
}
