@page "/register"

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-4 w-100" Style="border-radius: 12px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2"><strong>Criar Conta</strong></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="opacity-70">Preencha os dados para se registrar</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        
        <MudCardContent>
            @if (ExibirMensagem)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@AvisoMensagem</MudAlert>
                <div class="d-none">
                    <Aviso Exibir="@ExibirMensagem">@AvisoMensagem</Aviso>
                </div>
            }

            <EditForm Model="@userInfo" OnValidSubmit="RegistrarUsuario">
                <DataAnnotationsValidator />
                
                <MudTextField @bind-Value="userInfo.Email" 
                              For="@(() => userInfo.Email)"
                              Label="E-mail" 
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End" 
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4" />

                <MudTextField @bind-Value="userInfo.Password" 
                              For="@(() => userInfo.Password)"
                              Label="Senha" 
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@PasswordInput"
                              Adornment="Adornment.End" 
                              AdornmentIcon="@PasswordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Mostrar Senha"
                              Class="mb-6" />

                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large" 
                           FullWidth="true"
                           Class="py-2"
                           Style="border-radius: 8px;">
                    <strong>REGISTRAR</strong>
                </MudButton>
            </EditForm>
        </MudCardContent>
        
        <MudCardActions Class="d-flex justify-center mt-2 pb-4">
            <MudText Typo="Typo.body2">Já possui uma conta?</MudText>
            <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Class="ml-2">Faça Login</MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>
@code {
    private bool ExibirMensagem = false;
    [Parameter]
    public string AvisoMensagem { get; set; }
    private UserInfo userInfo = new UserInfo();

    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    private async Task RegistrarUsuario()
    {
        try
        {
            var registerAsJson = JsonSerializer.Serialize(userInfo);
            var httpResonse = await Http.PostAsync("api/account/register", new StringContent(
                registerAsJson, Encoding.UTF8, "application/json"));

            if (!httpResonse.IsSuccessStatusCode)
            {
                var responseAsString = await httpResonse.Content.ReadAsStringAsync();
                try 
                {
                    var errorResult = JsonSerializer.Deserialize<Dictionary<string, object>>(
                        responseAsString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    
                    if (errorResult != null && errorResult.ContainsKey("errors"))
                    {
                        var errorsList = JsonSerializer.Deserialize<List<string>>(errorResult["errors"].ToString());
                        AvisoMensagem = string.Join(" | ", errorsList);
                    }
                    else
                    {
                        AvisoMensagem = "Falha ao registrar o usuário.";
                    }
                }
                catch
                {
                    AvisoMensagem = "Ocorreu um erro ao tentar registrar o usuário.";
                }
                
                ExibirMensagem = true;
            }
            else
            {
                Snackbar.Add("Conta criada com sucesso! Redirecionando para o login...", Severity.Success);
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/login");
            }
        }
        catch
        {
            ExibirMensagem = true;
            AvisoMensagem = "Ocorreu um erro ao tentar registrar o usuário. Por favor, tente novamente.";
        }
    }
}
